# Copy to .env and fill in real values. Do not commit .env.
DJANGO_SECRET_KEY=
GOOGLE_BOOKS_API_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (dj-database-url). Optional locally: if unset, settings.py falls
# back to postgres://dogeared_app@localhost/dogeared
# DATABASE_URL=postgres://dogeared_app@localhost/dogeared
#
# Neon (prod). Direct string for migrations; -pooler string for the app on an
# elastic host (also set DISABLE_SERVER_SIDE_CURSORS=True there):
# DATABASE_URL=postgres://USER:PASSWORD@HOST/dogeared?sslmode=require&connect_timeout=15
